# Copy to .env and fill in. Used by docker-compose.prod.yml.
# NEVER commit the filled-in .env (.gitignore already excludes it).

# --- Public domain / TLS -----------------------------------------------------
# REQUIRED — your own domain, the one Caddy gets a certificate for.
CAIRN_DOMAIN=cairn.example
# REQUIRED — short URLs the API mints, baked into every artifact. Must match the
# public origin, no trailing slash. There is deliberately no default: an unset
# value would make your instance hand out links to somebody else's hostname.
CAIRN_BASE_URL=https://cairn.example
# Email for Let's Encrypt expiry notices (optional but recommended).
CAIRN_ACME_EMAIL=you@example.com

# --- Who may sign in ---------------------------------------------------------
# Configure at least one of these. With none of them set cairnd still STARTS —
# it logs a warning and every authenticated endpoint rejects every caller, so
# the instance looks healthy and refuses every create.
#
# OIDC — humans sign in through your identity provider; agents authorize over
# OAuth against it.
#CAIRN_OIDC_ISSUER=https://id.example
#CAIRN_OIDC_CLIENT_ID=cairn
#CAIRN_OIDC_CLIENT_SECRET=
#
# Static API tokens for scripts and agents: comma-separated `secret:actor[:role]`
# where role is human (default) or agent. Secrets are stored hashed; an agent
# token is barred from human-only operations such as delete. Generate secrets
# with e.g. `openssl rand -hex 24`.
#CAIRN_API_TOKENS=s3cret-one:you@example.com,s3cret-two:bot@example.com:agent
#
# Shared web-login password, for a single-user or development instance. If
# CAIRN_OIDC_ISSUER is also set, OIDC wins and this is disabled (ADR-0013).
#CAIRN_DEV_LOGIN_PASSWORD=

# --- Outbound webhooks (ADR-0017 / SPEC-0012) --------------------------------
# Comma-separated target URLs that receive a signed `artifact.created` event
# after every artifact creation. Empty = feature inert. These URLs are bearer
# capabilities (e.g. Switchboard ingest URLs) — never log or share them.
#CAIRN_OUTBOUND_WEBHOOK_URLS=https://switchboard.example/webhooks/w/token1,https://switchboard.example/webhooks/w/token2
# Optional HMAC-SHA256 secret; when set every delivery carries
# X-Cairn-Signature: sha256=<hex> over the raw body.
#CAIRN_OUTBOUND_WEBHOOK_SECRET=

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=cairn
POSTGRES_DB=cairn
# REQUIRED — pick a strong value (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me

# --- Object storage (MinIO) --------------------------------------------------
# REQUIRED — do NOT ship the minioadmin/minioadmin defaults on a public host.
CAIRN_S3_ACCESS_KEY=change-me
CAIRN_S3_SECRET_KEY=change-me-too
CAIRN_S3_BUCKET=cairn
CAIRN_S3_REGION=us-east-1

# --- Limits / retention ------------------------------------------------------
# Default artifact TTL (Go duration). 168h = 7 days (ADR-0007).
CAIRN_DEFAULT_TTL=168h
# Max upload size in bytes (default 64 MiB).
CAIRN_MAX_UPLOAD_BYTES=67108864
# Preview size bound in bytes (default 5 MiB).
CAIRN_PREVIEW_MAX_BYTES=5242880
# Per-IP rate limit: tokens/sec and burst.
CAIRN_RATE_PER_SECOND=20
CAIRN_RATE_BURST=40
