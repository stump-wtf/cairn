# Copy to .env and fill in. These are the variables the self-hosting guide's
# compose file forwards to cairnd (https://cairn.stump.wtf/docs/guides/self-hosting/)
# plus the Caddy TLS pair; docker-compose.yml is local development and needs
# none of them. NEVER commit the filled-in .env (.gitignore already excludes it).
# Everything commented out has a working default; uncomment only what you need.

# --- Public domain / TLS ------------------------------------------------------
# REQUIRED — the domain Caddy serves and obtains a Let's Encrypt certificate for.
CAIRN_DOMAIN=
# REQUIRED — short URLs the API mints (must match the public origin, no trailing
# slash; the guide's compose derives it from CAIRN_DOMAIN).
CAIRN_BASE_URL=
# Email for Let's Encrypt expiry notices (optional but recommended).
#CAIRN_ACME_EMAIL=

# --- Sign-in: OIDC (Pocket ID, or any OIDC provider) ---------------------------
#CAIRN_OIDC_ISSUER=
#CAIRN_OIDC_CLIENT_ID=
#CAIRN_OIDC_CLIENT_SECRET=

# --- Sign-in: static API tokens (scripts and agents) ---------------------------
# Comma-separated token[:principal][:agent] entries, e.g.
#   CAIRN_API_TOKENS=s3cret-one:you@example.com,s3cret-two:bot@example.com:agent
#CAIRN_API_TOKENS=

# --- Sign-in: GitHub OAuth (web login) -----------------------------------------
#CAIRN_GITHUB_CLIENT_ID=
#CAIRN_GITHUB_CLIENT_SECRET=

# --- Outbound webhooks (ADR-0017 / SPEC-0012) --------------------------------
# Comma-separated target URLs that receive a signed `artifact.created` event
# after every artifact creation. Empty = feature inert. These URLs are bearer
# capabilities (e.g. Switchboard ingest URLs) — never log or share them.
#CAIRN_OUTBOUND_WEBHOOK_URLS=https://switchboard.example/webhooks/w/token1,https://switchboard.example/webhooks/w/token2
# Optional HMAC-SHA256 secret; when set every delivery carries
# X-Cairn-Signature: sha256=<hex> over the raw body.
#CAIRN_OUTBOUND_WEBHOOK_SECRET=

# --- Postgres ----------------------------------------------------------------
# REQUIRED — pick a strong value (e.g. `openssl rand -hex 24`).
#POSTGRES_PASSWORD=
#POSTGRES_USER=cairn
#POSTGRES_DB=cairn

# --- Object storage (MinIO) --------------------------------------------------
# REQUIRED — do NOT ship the minioadmin/minioadmin defaults on a public host.
#CAIRN_S3_ACCESS_KEY=
#CAIRN_S3_SECRET_KEY=
#CAIRN_S3_BUCKET=cairn
#CAIRN_S3_REGION=us-east-1

# --- Limits / retention ------------------------------------------------------
# Default artifact TTL (Go duration). 168h = 7 days (ADR-0007).
#CAIRN_DEFAULT_TTL=168h
# Max upload size in bytes (default 64 MiB).
#CAIRN_MAX_UPLOAD_BYTES=67108864
# Preview size bound in bytes (default 5 MiB).
#CAIRN_PREVIEW_MAX_BYTES=5242880
# Per-IP rate limit: tokens/sec and burst.
#CAIRN_RATE_PER_SECOND=20
#CAIRN_RATE_BURST=40
