# Caddy reverse proxy for Cairn. Caddy obtains and renews a Let's Encrypt
# certificate for $CAIRN_DOMAIN automatically (ports 80 + 443 must be reachable
# and the DNS record must point here).

{
	# Optional: set CAIRN_ACME_EMAIL in .env for expiry notices.
	email {$CAIRN_ACME_EMAIL}
}

{$CAIRN_DOMAIN} {
	encode gzip

	# --- Optional: put the whole site behind HTTP basic auth ---
	# Not needed to make creation safe: creation already requires a credential.
	# An unregistered bearer token is rejected with 401, and only OIDC sessions
	# and tokens registered in CAIRN_API_TOKENS can create anything. (The
	# trust-any-bearer development stub is opt-in via
	# CAIRN_DEV_INSECURE_BEARER_AUTH, defaults to off, and warns at startup.)
	#
	# Reach for this only if you want the instance itself unlisted — remember
	# that artifact links are read capabilities by design (ADR-0007), so basic
	# auth is how you stop strangers reaching the site at all, not how you
	# control who may create. Generate a hash with:
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpass'
	# then uncomment:
	#
	# basic_auth {
	# 	admin <PASTE-BCRYPT-HASH-HERE>
	# }

	reverse_proxy cairnd:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
