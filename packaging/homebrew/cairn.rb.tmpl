# Generated by stump.wtf/cairn's release pipeline (the tap-bump job) from
# packaging/homebrew/cairn.rb.tmpl in https://github.com/stump-wtf/cairn.
# Edit the template there, not this file: the next release overwrites it.
class Cairn < Formula
  # A Binary Formula, Not A Build-From-Source One
  #
  # Every other formula in this tap (harness, msgbrowse, reduit) compiles from a
  # public source tarball. cairn pins prebuilt binaries instead, four url/sha256
  # pairs installed directly, so installing needs no Go toolchain. The release
  # path is built around that: a v* tag publishes cross-platform archives to
  # github.com/stump-wtf/cairn-cli (binaries only), and the tap-bump job renders
  # this file from those assets.
  #
  # The urls carry the version literally, with no separate `version` line.
  # `brew audit --strict` rejects a `version` that the url already implies, and
  # rendering the whole file means there is no line to keep in sync.
  #
  # Assets come from GitHub, never the canonical Gitea host, which is reachable
  # only on its own network: a Gitea-hosted download hangs for everyone else.
  desc "Share files, logs, and diffs as short links with provenance and a TTL"
  homepage "https://cairn.stump.wtf"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/stump-wtf/cairn-cli/releases/download/v@VERSION@/cairn_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/stump-wtf/cairn-cli/releases/download/v@VERSION@/cairn_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/stump-wtf/cairn-cli/releases/download/v@VERSION@/cairn_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/stump-wtf/cairn-cli/releases/download/v@VERSION@/cairn_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  def install
    # The archive holds exactly `cairn` and `LICENSE` at its root
    # (.goreleaser.yaml pins archives.files to [LICENSE] and leaves
    # wrap_in_directory off), so name the binary rather than globbing: a glob
    # would install LICENSE into bin/ as though it were a program.
    bin.install "cairn"
  end

  test do
    # goreleaser stamps the version with no leading "v", so `cairn --version`
    # prints the bare version.
    assert_match version.to_s, shell_output("#{bin}/cairn --version")
  end
end
